+    // Neutral-axis offsets from the centroid, where the LINEAR sigma profile crosses
+    // zero (F75). sigma(y) = N/A + Mz*y/Iz is zero at y0 = -(N/A)*Iz/Mz; reported only
+    // when it falls strictly inside the section (|y0| < cz resp. |z0| < cy). A fully
+    // tensile or fully compressive section has NO neutral axis, and hasNaY/hasNaZ say
+    // so rather than defaulting the offset to a centroidal line that does not exist.
+    bool hasNaY = false;
+    real naY    = 0;       // offset along local y (crossing of the Mz bending profile)
+    bool hasNaZ = false;
+    real naZ    = 0;       // offset along local z (crossing of the My bending profile)
 };
 
 struct MemberStressTrace {
@@ -89,8 +98,18 @@ struct StressField {
 // Compute the stress field for a solved model. `samplesPerSpan` controls the number of
 // along-axis samples per member (must be >= 2; default 11; sampled at x = k*L/(n-1)).
 // Inactive members / shells are skipped (mirroring worstUtilization's contract).
+//
+// includeMomentExtrema (F74): additionally sample each member at the ANALYTIC interior
+// extremum of its bending moment diagrams, where dMz/dx = -Vy(x) = 0 resp. dMy/dx =
+// +Vz(x) = 0. Under a UDL the extremum generally falls between two uniform stations,
+// and a screen that only reads the uniform stations under-reports the very peak a
+// design check exists to find (a propped cantilever's span moment lives at x = 5L/8).
+// Extrema are inserted in x-order and deduplicated against existing stations; with no
+// UDL the shear is constant, no interior zero exists, and the samples are unchanged.
+// Default OFF: the uniform-station layout stays bit-identical to the pre-F74 contract.
 [[nodiscard]] FRAMECORE_API StressField computeStressField(const FrameModel& model,
                                                            const SolveResult& sr,
-                                                           int samplesPerSpan = 11);
+                                                           int samplesPerSpan = 11,
+                                                           bool includeMomentExtrema = false);
 
 } // namespace frame
