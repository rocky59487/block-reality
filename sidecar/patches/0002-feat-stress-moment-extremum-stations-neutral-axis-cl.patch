diff --git a/Plugins/FrameSolver/Source/FrameCore/Public/FrameCore/ShellEdgeRecovery.h b/Plugins/FrameSolver/Source/FrameCore/Public/FrameCore/ShellEdgeRecovery.h
new file mode 100644
index 0000000..77984ba
--- /dev/null
+++ b/Plugins/FrameSolver/Source/FrameCore/Public/FrameCore/ShellEdgeRecovery.h
@@ -0,0 +1,58 @@
+#pragma once
+#include "FrameCore/FrameTypes.h"
+#include "FrameCore/SolveResult.h"
+#include "FrameCore/ElasticAllowable.h"
+#include <array>
+#include <vector>
+
+// Clamped-edge support-moment recovery for MITC4 shells (F76).
+//
+// MITC4's per-corner moments are NOT superconvergent, and at a clamped edge they are
+// badly low: against Timoshenko's clamped square plate they under-report the support
+// moment by ~63% at 4 elements across and still ~26% at 14. Under-reporting the one
+// moment that governs a slab's supports is a silently-safe answer — the worst kind.
+//
+// The edge value is therefore RECOVERED instead of read: the moment field is smooth in
+// the interior, so it is extrapolated to the boundary from the two element CENTRES
+// normal to that edge — the textbook interior-to-boundary recovery
+//     M_edge ~= 1.5*M_1 - 0.5*M_2
+// which measures ~14% low at 8 elements and ~4% at 16, in place of ~40% and ~23%.
+//
+// It is applied only where it is defensible: an edge whose two corner nodes are fully
+// fixed, with a neighbour facet found by stepping twice the centre-to-edge vector
+// inwards (a REGULAR mesh assumption — on an irregular mesh the step finds no centre
+// and the raw value is kept), whose local frame agrees with this facet's, so the two
+// tensors being combined are expressed in the same axes. The recovery is adopted only
+// when it RAISES the screened demand — it is taken as the worse of the two — so a
+// failure to recover can never make a plate look safer.
+
+namespace frame {
+
+struct FrameModel;
+
+struct ShellEdgeRecoveryResult {
+    int  shellIdx  = -1;      // index into FrameModel::shells
+    int  shellId   = 0;       // mirrors model.shells[shellIdx].id
+    bool recovered = false;   // a clamped edge fired and raised the screened demand
+    // Per-corner {Mxx, Myy, Mxy} (ShellQuad::n order): the element's own output, and
+    // the field with the recovery applied where it fired (equal to raw otherwise).
+    // Both are reported: a document that quotes the size of a correction has to be
+    // able to show the number before it as well as after.
+    std::array<std::array<real, 3>, 4> McRaw{};
+    std::array<std::array<real, 3>, 4> Mc{};
+    // The elastic surface screen on both fields, so the demand consumer reads ONE
+    // source: risk/top/corner are checkShellSurface on the recovered field, riskRaw
+    // on the element's own.
+    real risk    = 0;
+    real riskRaw = 0;
+    bool top     = true;
+    int  corner  = -1;
+};
+
+// One entry per ACTIVE shell with valid geometry, in FrameModel::shells index order
+// (inactive or degenerate shells leave no entry, mirroring computeStressField).
+// Pure function of (model, result); no Eigen, no thread state.
+[[nodiscard]] FRAMECORE_API std::vector<ShellEdgeRecoveryResult>
+recoverShellEdgeMoments(const FrameModel& model, const SolveResult& sr);
+
+} // namespace frame
