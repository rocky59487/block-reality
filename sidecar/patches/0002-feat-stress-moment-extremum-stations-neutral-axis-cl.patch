index 9d4cdc7..6406abb 100644
--- a/Plugins/FrameSolver/Standalone/main.cpp
+++ b/Plugins/FrameSolver/Standalone/main.cpp
@@ -15,6 +15,7 @@
 #include "FrameCore/FrameSolver.h"
 #include "FrameCore/ElasticAllowable.h"
