diff --git a/Plugins/FrameSolver/Source/FrameCore/Private/ShellEdgeRecovery.cpp b/Plugins/FrameSolver/Source/FrameCore/Private/ShellEdgeRecovery.cpp
new file mode 100644
index 0000000..90a18b8
--- /dev/null
+++ b/Plugins/FrameSolver/Source/FrameCore/Private/ShellEdgeRecovery.cpp
@@ -0,0 +1,137 @@
+#include "FrameCore/ShellEdgeRecovery.h"
+#include "FrameCore/FrameModel.h"
+#include "FrameCore/Shell.h"
+#include "FrameCore/Material.h"
+#include <cmath>
+#include <map>
+
+namespace frame {
+
+namespace {
+
+struct FacetGeom {
+    bool ok = false;
+    Vec3 e1{ 0, 0, 0 }, e2{ 0, 0, 0 };
+    real cx = 0, cy = 0, cz = 0;
+};
+
+// The facet frame, rebuilt exactly as MITC4ShellElement::prepare builds it, so the
+// tensors being compared are expressed in the axes the resultants actually use.
+FacetGeom facetGeom(const FrameModel& m, const ShellQuad& sh) {
+    FacetGeom g;
+    const int i0 = m.nodeIndex(sh.n[0]), i1 = m.nodeIndex(sh.n[1]);
+    const int i2 = m.nodeIndex(sh.n[2]), i3 = m.nodeIndex(sh.n[3]);
+    if (i0 < 0 || i1 < 0 || i2 < 0 || i3 < 0) return g;
+    const Vec3 P0 = m.nodes[(size_t)i0].pos, P1 = m.nodes[(size_t)i1].pos;
+    const Vec3 P2 = m.nodes[(size_t)i2].pos, P3 = m.nodes[(size_t)i3].pos;
+    Vec3 n = cross(P2 - P0, P3 - P1);
+    const real nl = norm(n);
+    if (!(nl > 0)) return g;
+    n = n * (real(1) / nl);
+    Vec3 e1 = P1 - P0;
+    e1 = e1 - n * dot(e1, n);
+    const real e1l = norm(e1);
+    if (!(e1l > 0)) return g;
+    g.e1 = e1 * (real(1) / e1l);
+    g.e2 = cross(n, g.e1);
+    g.cx = real(0.25) * (P0.x + P1.x + P2.x + P3.x);
+    g.cy = real(0.25) * (P0.y + P1.y + P2.y + P3.y);
+    g.cz = real(0.25) * (P0.z + P1.z + P2.z + P3.z);
+    g.ok = true;
+    return g;
+}
+
+} // namespace
+
+std::vector<ShellEdgeRecoveryResult> recoverShellEdgeMoments(const FrameModel& m,
+                                                             const SolveResult& sr) {
+    const size_t nS = std::min(m.shells.size(), sr.shellForces.size());
+
+    // Geometry pass + centre index. The neighbour search steps twice the
+    // centre-to-edge-midpoint vector inwards; on a regular mesh that lands exactly on
+    // the next facet's centre, keyed here to the nearest integer millimetre.
+    std::vector<FacetGeom> geom(nS);
+    std::map<std::array<long long, 3>, size_t> byCentre;
+    auto keyOf = [](real x, real y, real z) {
+        return std::array<long long, 3>{ llround((double)x), llround((double)y), llround((double)z) };
+    };
+    std::vector<size_t> slot(nS, (size_t)-1);
+    std::vector<ShellEdgeRecoveryResult> out;
+    out.reserve(nS);
+    for (size_t k = 0; k < nS; ++k) {
+        const ShellQuad& sh = m.shells[k];
+        if (!sh.active || !(sh.t > 0)) continue;
+        if (sh.matIdx < 0 || sh.matIdx >= (int)m.materials.size()) continue;
+        geom[k] = facetGeom(m, sh);
+        if (!geom[k].ok) continue;
+        byCentre[keyOf(geom[k].cx, geom[k].cy, geom[k].cz)] = k;
+
+        ShellEdgeRecoveryResult r;
+        r.shellIdx = (int)k;
+        r.shellId  = sh.id;
+        const ShellElementForces& f = sr.shellForces[k];
+        for (int c = 0; c < 4; ++c) {
+            r.McRaw[(size_t)c] = { f.MxxC[c], f.MyyC[c], f.MxyC[c] };
+            r.Mc[(size_t)c]    = r.McRaw[(size_t)c];
+        }
+        slot[k] = out.size();
+        out.push_back(r);
+    }
+
+    for (size_t k = 0; k < nS; ++k) {
+        if (slot[k] == (size_t)-1) continue;
+        ShellEdgeRecoveryResult& dst = out[slot[k]];
+        const ShellQuad& sh = m.shells[k];
+        const ShellElementForces& f = sr.shellForces[k];
+        const Capacity& cap = m.materials[(size_t)sh.matIdx].cap;
+
+        ShellDemandResult d = checkShellSurface(f, sh.t, cap);
+        dst.riskRaw = d.risk;
+
+        for (int e = 0; e < 4; ++e) {
+            const int a = e, b = (e + 1) % 4;
+            const int ia = m.nodeIndex(sh.n[a]), ib = m.nodeIndex(sh.n[b]);
+            if (ia < 0 || ib < 0) continue;
+            auto allFixed = [&](int idx) {
+                for (int q = 0; q < 6; ++q) if (!m.nodes[(size_t)idx].fixed[q]) return false;
+                return true;
+            };
+            if (!allFixed(ia) || !allFixed(ib)) continue;
+
+            const Vec3& Pa = m.nodes[(size_t)ia].pos;
+            const Vec3& Pb = m.nodes[(size_t)ib].pos;
+            const real mx = real(0.5) * (Pa.x + Pb.x);
+            const real my = real(0.5) * (Pa.y + Pb.y);
+            const real mz = real(0.5) * (Pa.z + Pb.z);
+            auto it = byCentre.find(keyOf(geom[k].cx + 2 * (geom[k].cx - mx),
+                                          geom[k].cy + 2 * (geom[k].cy - my),
+                                          geom[k].cz + 2 * (geom[k].cz - mz)));
+            if (it == byCentre.end()) continue;
+            const size_t nb = it->second;
+            if (dot(geom[k].e1, geom[nb].e1) < real(0.999) ||
+                dot(geom[k].e2, geom[nb].e2) < real(0.999)) continue;
+
+            ShellElementForces g = f;
+            const ShellElementForces& h = sr.shellForces[nb];
+            const real rxx = real(1.5) * f.Mxx - real(0.5) * h.Mxx;
+            const real ryy = real(1.5) * f.Myy - real(0.5) * h.Myy;
+            const real rxy = real(1.5) * f.Mxy - real(0.5) * h.Mxy;
+            for (int c : { a, b }) { g.MxxC[c] = rxx; g.MyyC[c] = ryy; g.MxyC[c] = rxy; }
+            const ShellDemandResult dr = checkShellSurface(g, sh.t, cap);
+            if (dr.risk > d.risk) {
+                d = dr;
+                dst.recovered = true;
+                dst.Mc[(size_t)a] = { rxx, ryy, rxy };
+                dst.Mc[(size_t)b] = { rxx, ryy, rxy };
+            }
+        }
+
+        dst.risk   = d.risk;
+        dst.top    = d.top;
+        dst.corner = d.corner;
+    }
+
+    return out;
+}
+
+} // namespace frame
