+    // ---------- F74: analytic moment-extremum stations ----------
+    // A screen that reads only uniform stations misses interior peaks that fall between
+    // them. Propped cantilever under UDL: the span extremum sits at x = 5L/8 with
+    // |M| = 9wL^2/128 -- never on an 11-station grid. With includeMomentExtrema the
+    // field must sample it exactly; without, the layout stays the uniform contract.
+    {
+        std::printf("[F74] analytic moment-extremum stations (propped cantilever, UDL)\n");
+        Material smat(200000.0, 200000.0 / (2.0 * 1.29), 7850.0);
+        smat.nu  = 0.29;
+        smat.cap = Capacity::make(350.0, 500.0, 200.0);
+        const Section ns = Section::Rectangular(200.0, 400.0);
+        const real L = 8000.0;
+        const real w = smat.rho * ns.A * 9810.0 * 1e-12;
+
+        FrameModel m;
+        Node ni(1, 0, 0, 0); ni.fixAll();
+        Node nj(2, L, 0, 0);
+        for (int q = 0; q < 3; ++q) nj.fixed[q] = true;   // pinned far end
+        m.nodes.push_back(ni);
+        m.nodes.push_back(nj);
+        m.materials.push_back(smat);
+        m.sections.push_back(ns);
+        m.members.push_back(Member(1, 1, 2, 0, 0));
+        addSelfWeight(m);
+        std::string why;
+        checkTrue("F74 model valid", m.validate(why), why);
+        SolveResult r = solve(m);
+        checkTrue("F74 non-singular", !r.singular, r.diagnostic);
+
+        const StressField uni = computeStressField(m, r, 11, false);
+        checkTrue("F74 uniform layout unchanged when OFF (11 stations)",
+                  uni.members.front().samples.size() == 11,
+                  "got=" + std::to_string(uni.members.front().samples.size()));
+
+        const StressField fld = computeStressField(m, r, 11, true);
+        const MemberStressTrace& tr = fld.members.front();
+        checkTrue("F74 one extremum inserted (12 stations)",
+                  tr.samples.size() == 12,
+                  "got=" + std::to_string(tr.samples.size()));
+        // Locate the non-uniform station and pin it to the closed form.
+        const real xStar = 5.0 * L / 8.0, mStar = 9.0 * w * L * L / 128.0;
+        bool found = false;
+        for (const MemberStressSample& s : tr.samples) {
+            if (std::fabs((double)(s.x - xStar)) < 1e-6 * L) {
+                found = true;
+                checkClose("F74 extremum |M| = 9wL^2/128", std::fabs((double)s.Mz), mStar, 1e-9);
+                checkTrue("F74 extremum V ~ 0", std::fabs((double)s.Vy) < 1e-9 * w * L,
+                          "V=" + std::to_string((double)s.Vy));
+            }
+        }
+        checkTrue("F74 extremum station at x = 5L/8", found, "");
+        // The cantilever's shear zero sits exactly AT the free tip: no interior
+        // extremum exists and the layout must stay uniform even when ON.
+        {
+            FrameModel mc;
+            Node ci(1, 0, 0, 0); ci.fixAll();
+            Node cj(2, L, 0, 0);
+            mc.nodes.push_back(ci);
+            mc.nodes.push_back(cj);
+            mc.materials.push_back(smat);
+            mc.sections.push_back(ns);
+            mc.members.push_back(Member(1, 1, 2, 0, 0));
+            addSelfWeight(mc);
+            SolveResult rc = solve(mc);
+            const StressField fc = computeStressField(mc, rc, 11, true);
+            checkTrue("F74 cantilever: no interior extremum, 11 stations",
+                      fc.members.front().samples.size() == 11,
+                      "got=" + std::to_string(fc.members.front().samples.size()));
+        }
+    }
+
+    // ---------- F75: neutral-axis offset ----------
+    // sigma is linear across the depth, so its zero crossing is at y0 = -(N/A)*Iz/Mz.
+    // Pure bending puts it at the centroid; axial compression pushes it towards the
+    // tension face; enough axial and the section has NO neutral axis at all, which the
+    // field must say rather than defaulting a line through the centroid.
+    {
+        std::printf("[F75] neutral-axis offset (axial + bending closed form)\n");
+        Material smat(200000.0, 200000.0 / (2.0 * 1.29), 7850.0);
+        smat.nu  = 0.29;
+        smat.cap = Capacity::make(350.0, 500.0, 200.0);
+        const Section ns = Section::Rectangular(200.0, 400.0);
+        // F sized so the crossing falls INSIDE the section: |y0| = (F/A)*Iz/(P*L)
+        // = 133 mm < cz = 200 mm. (At 2e5 the crossing sits at 1333 mm, far outside,
+        // and hasNaY == false is the CORRECT answer -- case (c) covers that regime.)
+        const real L = 2000.0, P = 1000.0, F = 2.0e4;
+
+        auto tipLoaded = [&](real axialN, real transZ) {
+            FrameModel m;
+            Node ni(1, 0, 0, 0); ni.fixAll();
+            Node nj(2, L, 0, 0);
+            m.nodes.push_back(ni);
+            m.nodes.push_back(nj);
+            m.materials.push_back(smat);
+            m.sections.push_back(ns);
+            Member mem(1, 1, 2, 0, 0);
+            m.members.push_back(mem);
+            NodalLoad nl;
+            nl.node = 2;
+            nl.comp[Ux] = axialN;    // along the member axis
+            nl.comp[Uz] = transZ;    // global +Z -> local +y (default frame)
+            m.nodalLoads.push_back(nl);
+            return m;
+        };
+
+        // (a) pure bending: neutral axis exists at the centroid.
+        {
+            FrameModel m = tipLoaded(0, P);
+            SolveResult r = solve(m);
+            const StressField fld = computeStressField(m, r, 11);
+            const MemberStressSample& s0 = fld.members.front().samples.front();
+            checkTrue("F75(a) pure bending: hasNaY", s0.hasNaY, "");
+            checkTrue("F75(a) pure bending: naY == 0 (centroid)",
+                      std::fabs((double)s0.naY) < 1e-9 * ns.cz,
+                      "naY=" + std::to_string((double)s0.naY));
+        }
+        // (b) axial + bending: y0 = -(N/A)*Iz/Mz, and sigma(y0) == 0 by the kernel.
+        {
+            FrameModel m = tipLoaded(-F, P);   // compression + bending
+            SolveResult r = solve(m);
+            const StressField fld = computeStressField(m, r, 11);
+            const MemberStressSample& s0 = fld.members.front().samples.front();
+            checkTrue("F75(b) axial+bending: hasNaY", s0.hasNaY, "");
+            const real y0 = -(s0.N / ns.A) * ns.Iz / s0.Mz;
+            checkClose("F75(b) naY == -(N/A)*Iz/Mz", s0.naY, y0, 1e-12);
+            const real sigmaAtNa = s0.N / ns.A + s0.Mz * s0.naY / ns.Iz;
+            checkTrue("F75(b) sigma(naY) == 0 (definitional interlock)",
+                      std::fabs((double)sigmaAtNa) < 1e-12 * std::fabs((double)s0.sigmaFiberTopY),
+                      "sigma=" + std::to_string((double)sigmaAtNa));
+            checkTrue("F75(b) crossing is strictly inside the section",
+                      std::fabs((double)s0.naY) < ns.cz, "");
+        }
+        // (c) axial dominates: no crossing inside the section -> no neutral axis.
+        {
+            FrameModel m = tipLoaded(-100.0 * F, P);
+            SolveResult r = solve(m);
+            const StressField fld = computeStressField(m, r, 11);
+            const MemberStressSample& s0 = fld.members.front().samples.front();
+            checkTrue("F75(c) axial-dominated: hasNaY == false", !s0.hasNaY, "");
+        }
+    }
+
+    // ---------- F76: clamped-edge support-moment recovery ----------
+    // MITC4 corner moments at a clamped edge are badly low (silently safe). The
+    // interior-to-boundary extrapolation 1.5*M1 - 0.5*M2 must cut the error against
+    // Timoshenko's clamped-plate support moment (|M| = 0.0513 q a^2 at the edge
+    // midpoint) roughly in half or better, and by contract can only RAISE the screened
+    // demand, never lower it.
+    {
+        std::printf("[F76] clamped-edge support-moment recovery (Timoshenko plate)\n");
+        const real a = 1000.0, t = 10.0, q = 0.01;
+        Material smat(210000.0, 80769.0, 7850.0);
+        smat.nu = 0.3;
+        smat.cap = Capacity::make(300.0, 300.0, 180.0);
+        FrameModel m; fixtures::clampedPlateShell(m, a, t, 8, q, smat);
+        SolveResult r = solve(m);
+        checkTrue("F76 solve non-singular", !r.singular, r.diagnostic);
+
+        const std::vector<ShellEdgeRecoveryResult> rec = recoverShellEdgeMoments(m, r);
+        checkTrue("F76 one entry per active shell (64)", rec.size() == 64,
+                  "got=" + std::to_string(rec.size()));
+
+        const real mRef = 0.0513 * q * a * a;   // Timoshenko, clamped square, edge midpoint
+        real worstRaw = 0, worstRec = 0;
+        int nRecovered = 0;
+        bool monotone = true;
+        for (const ShellEdgeRecoveryResult& e : rec) {
+            if (e.recovered) ++nRecovered;
+            if (e.risk < e.riskRaw - 1e-12) monotone = false;
+            for (int c = 0; c < 4; ++c) {
+                worstRaw = std::max(worstRaw, std::max(std::fabs((double)e.McRaw[(size_t)c][0]),
+                                                       std::fabs((double)e.McRaw[(size_t)c][1])));
+                worstRec = std::max(worstRec, std::max(std::fabs((double)e.Mc[(size_t)c][0]),
+                                                       std::fabs((double)e.Mc[(size_t)c][1])));
+            }
+        }
+        checkTrue("F76 recovery fired on boundary facets", nRecovered > 0,
+                  "recovered=" + std::to_string(nRecovered));
+        checkTrue("F76 risk >= riskRaw on every facet (recovery can only raise demand)",
+                  monotone, "");
+        const double errRaw = std::fabs(worstRaw - mRef) / mRef;
+        const double errRec = std::fabs(worstRec - mRef) / mRef;
+        checkTrue("F76 raw support moment is badly low (err > 30%)", errRaw > 0.30,
+                  "errRaw=" + std::to_string(errRaw));
+        checkTrue("F76 recovered support moment within 16% at 8 elements", errRec < 0.16,
+                  "errRec=" + std::to_string(errRec));
+        checkTrue("F76 recovery reduces the error", errRec < errRaw,
+                  "raw=" + std::to_string(errRaw) + " rec=" + std::to_string(errRec));
+    }
+
     std::printf("\n%s  (failures=%d)\n", g_fail == 0 ? "ALL PASS" : "FAILURES", g_fail);
     return g_fail == 0 ? 0 : 1;
 }
