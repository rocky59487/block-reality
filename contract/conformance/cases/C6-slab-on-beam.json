{"case":"C6-slab-on-beam","family":"C-6","grade":"hard",
 "requires":["bsi.core","bsi.readback.members","bsi.readback.shells"],
 "note":"block-reality N15-a/b/c/e. Beam 5 blocks x=0..4 y=0 grounded at both ends; slab 5x3 panel blocks at y=1, z=-1..1 resting on it. Slab weight = 15 * 1m^2 * 0.2 m * 2400 * 9.81 = 70632 N. Run once without the slab (A) and once with (B): reaction increases by exactly the slab weight.",
 "vocab":{"version":1,
   "materials":[
     {"name":"steel","role":"member","model":"isotropic","E":2.0e11,"nu":0.3,"rho":7850,"allow":{"sigmaC":2.5e8,"sigmaT":2.5e8,"tau":1.45e8},"defaultSection":"steel_rect_200x400"},
     {"name":"concrete_slab_200","role":"panel","model":"isotropic","E":3.0e10,"nu":0.2,"rho":2400,"shellThickness":0.2,"allow":{"sigmaC":3.0e7,"sigmaT":3.0e6,"tau":4.0e6}},
     {"name":"ground_rigid","role":"support","supportKind":"fixAll"}],
   "sections":[{"name":"steel_rect_200x400","kind":"rect","p":[0.2,0.4]}]},
 "worlds":{
   "A":[[0,-1,0,"ground_rigid",null,0,0,0,1,1],[4,-1,0,"ground_rigid",null,0,0,0,1,1],
        [0,0,0,"steel",null,0,0,0,1,1],[1,0,0,"steel",null,0,0,0,1,1],[2,0,0,"steel",null,0,0,0,1,1],[3,0,0,"steel",null,0,0,0,1,1],[4,0,0,"steel",null,0,0,0,1,1]],
   "B":{"extends":"A","add":[
        [0,1,-1,"concrete_slab_200",null,0,0,0,1,1],[1,1,-1,"concrete_slab_200",null,0,0,0,1,1],[2,1,-1,"concrete_slab_200",null,0,0,0,1,1],[3,1,-1,"concrete_slab_200",null,0,0,0,1,1],[4,1,-1,"concrete_slab_200",null,0,0,0,1,1],
        [0,1,0,"concrete_slab_200",null,0,0,0,1,1],[1,1,0,"concrete_slab_200",null,0,0,0,1,1],[2,1,0,"concrete_slab_200",null,0,0,0,1,1],[3,1,0,"concrete_slab_200",null,0,0,0,1,1],[4,1,0,"concrete_slab_200",null,0,0,0,1,1],
        [0,1,1,"concrete_slab_200",null,0,0,0,1,1],[1,1,1,"concrete_slab_200",null,0,0,0,1,1],[2,1,1,"concrete_slab_200",null,0,0,0,1,1],[3,1,1,"concrete_slab_200",null,0,0,0,1,1],[4,1,1,"concrete_slab_200",null,0,0,0,1,1]]},
   "B_mirror":{"transform":"mirror_x","of":"B"},
   "B_rot90":{"transform":"rot90_y","of":"B"}},
 "solve":{"selfWeight":true,"gravity":[0,-9.81,0],"include":["members","shells"],"precision":{"tier":"commit"}},
 "derive":{"slabW":"15*1*0.2*2400*9.81"},
 "assert":[
   {"world":"B","path":"status","eq":"ok"},
   {"world":"B","path":"diag.islands","eq":1},{"world":"B","path":"diag.singularIslands","eq":0},
   {"world":"B","path":"members","count_ge":1},{"world":"B","path":"facets","count_ge":1},
   {"world":"B","path":"equilibrium.residual","le":1e-9},
   {"delta":["B","A"],"path":"equilibrium.reaction[1]","eq":"slabW","rel":1e-9},
   {"world":"B_mirror","path":"diag.islands","eq":1},{"world":"B_rot90","path":"diag.islands","eq":1},
   {"equal":["B","B_mirror"],"path":"equilibrium.reaction[1]","rel":1e-12},
   {"equal":["B","B_rot90"],"path":"equilibrium.reaction[1]","rel":1e-12},
   {"world":"B","path":"unassigned","count":0}
 ]}
